APP_NAME=2608B_iCloud
DEBUG=false

# 领取凭证里的取码 URL 根地址（注册机访问用）。本地可留空，默认 http://127.0.0.1:8770
# PUBLIC_BASE_URL=http://127.0.0.1:8770

ICLOUD_DOMAIN=icloud.com
# 中国区可改成 icloud.com.cn；命令行 --region cn / --suffix cn 可临时覆盖

# 加载 accounts/ 下全部 .yml / .yaml（一文件一账户）
# 见 accounts/_example.yaml.example
# 嵌套：mail + apple / 163mail / inbox；也可扁平 mail/app_password/cookie
ACCOUNTS_FILES=accounts/

# Camoufox 浏览器二进制（仅项目内，不用全局 cache）
CAMOUFOX_DIR=browsers/camoufox
# 下载代理：默认代码内 127.0.0.1:7897；none 关闭；也可只设 HTTPS_PROXY
CAMOUFOX_PROXY=http://127.0.0.1:7897
# Patchright Chromium 页面代理；留空/none/direct 表示直连；支持 http://、https://、socks5://
PATCHRIGHT_PROXY=
# HME API 网络策略：先直连；直连发生传输异常时再使用此代理。
# 也可把代理与项目变量写入根目录 proxy.yaml（模板已提供）。
# 留空时依次读取 HTTPS_PROXY、HTTP_PROXY、ALL_PROXY、CAMOUFOX_PROXY。
# 支持 http://、https://、socks5://、socks5h://；none/off/direct 表示不使用代理。
HME_PROXY=
# 可选：提高 GitHub API 限额
# GITHUB_TOKEN=
# 采集/运行日志目录
LOG_DIR=logs

CLIENT_BUILD=2610Hotfix23
CLIENT_ID=37bd9669-50c3-4d52-af42-1d240d3ac4f3

# ---------- 收件服务器 ----------
# 下列默认值开箱即可收取 icloud.com 与 163.com，一般不需要改。
# 需要强制更改（自建/企业邮、端口被封、走中转）时改这里，代码不用动。
# 选用哪一套由「邮箱地址的域名」决定：地址落在 *_DOMAINS 里就用对应那组。
# 这点很重要——Apple ID 可以是 163 地址，此时收件必须走 163 的服务器。
MAIL_APPLE_IMAP_HOST=imap.mail.me.com
MAIL_APPLE_IMAP_PORT=993
MAIL_APPLE_SMTP_HOST=smtp.mail.me.com
MAIL_APPLE_SMTP_PORT=587
MAIL_APPLE_SMTP_SSL=false
MAIL_APPLE_SMTP_STARTTLS=true
MAIL_APPLE_IMAP_ID=false
MAIL_APPLE_DOMAINS=icloud.com,me.com,mac.com

MAIL_163_IMAP_HOST=imap.163.com
MAIL_163_IMAP_PORT=993
MAIL_163_SMTP_HOST=smtp.163.com
MAIL_163_SMTP_PORT=465
MAIL_163_SMTP_SSL=true
MAIL_163_SMTP_STARTTLS=false
# 网易要求登录后发送 IMAP ID，否则报 Unsafe Login
MAIL_163_IMAP_ID=true
MAIL_163_DOMAINS=163.com,126.com,yeah.net,vip.163.com

# ---------- mail.com Web API ----------
# HTTPS REST 登录 / OAuth / 收件请求代理；留空表示直连，none/off/direct 表示强制直连。
# 支持 http://、socks5://、socks5h://；socks5h 会让 DNS 解析也通过代理。
# 也可在 mail.com TXT 行末追加第三段：邮箱----密码----http://127.0.0.1:7897
MAILCOM_PROXY=

# ---------- Web 工作台登录（默认开启；生产勿关） ----------
# 会话签名密钥，务必换成足够长的随机串
AUTH_SESSION_SECRET=change-me
# 两个固定用户名 lws / mhw 的明文密码（只写在服务器本地 .env，勿提交）
AUTH_PASSWORD_LWS=change-me
AUTH_PASSWORD_MHW=change-me
# HTTPS 部署时设 true，使会话 cookie 带 Secure
AUTH_COOKIE_SECURE=false
# 反代后按 X-Forwarded-For 做登录限流时再开；默认不信该头
# AUTH_TRUST_PROXY=false
# 仅本地/测试逃生口，生产不要开
# AUTH_DISABLED=false
# 会话有效期秒数，默认 7 天
# AUTH_SESSION_MAX_AGE=604800

